# Opcional: configure somente quando precisar usar um celular físico ou outro host.
# Android Emulator usa 10.0.2.2 automaticamente; iOS Simulator e Web usam localhost.
# Para celular físico, descomente e substitua pelo IPv4 do computador na rede Wi-Fi:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3333/api
